<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Black Background Circle -->
    <path
        android:fillColor="#000000"
        android:pathData="M100,100m-95,0a95,95 0,1,1 190,0a95,95 0,1,1 -190,0" />

    <!-- Outer Glowing Ring -->
    <path
        android:pathData="M100,100m-92,0a92,92 0,1,1 184,0a92,92 0,1,1 -184,0"
        android:strokeWidth="2.5"
        android:strokeColor="#DDFFFFFF" />

    <!-- Main Large Flame (Red/Orange) -->
    <path android:pathData="M100,25 Q160,80 160,140 Q160,180 100,185 Q40,180 40,140 Q40,80 100,25">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="100" android:startY="25" android:endX="100" android:endY="185" android:type="linear">
                <item android:color="#E67E22" android:offset="0" />
                <item android:color="#E74C3C" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mid Flame Layer (Orange/Yellow) -->
    <path android:pathData="M100,50 Q140,90 140,135 Q140,165 100,175 Q60,165 60,135 Q60,90 100,50">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="100" android:startY="50" android:endX="100" android:endY="175" android:type="linear">
                <item android:color="#F1C40F" android:offset="0" />
                <item android:color="#E67E22" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Hot Core (Yellow/White) -->
    <path android:pathData="M100,80 Q120,110 120,140 Q120,160 100,165 Q80,160 80,140 Q80,110 100,80">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="100" android:startY="80" android:endX="100" android:endY="165" android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#F1C40F" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Forest Silhouette (Detailed Pine Trees) -->
    <path
        android:fillColor="#000000"
        android:pathData="M30,175 L45,155 L40,155 L55,135 L50,135 L65,110 L80,135 L75,135 L90,155 L85,155 L100,175 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M80,175 L95,145 L90,145 L110,120 L130,145 L125,145 L140,175 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M120,175 L140,140 L135,140 L155,115 L175,140 L170,140 L185,175 Z" />
    
    <!-- Base Fill -->
    <path
        android:fillColor="#000000"
        android:pathData="M20,170 Q100,195 180,170 L180,190 L20,190 Z" />

    <!-- Embers/Sparks -->
    <path android:fillColor="#F1C40F" android:pathData="M55,90 l2,2 l2,-2 l-2,-2 z" />
    <path android:fillColor="#E67E22" android:pathData="M145,70 l2,2 l2,-2 l-2,-2 z" />
    <path android:fillColor="#F1C40F" android:pathData="M165,110 l1.5,1.5 l1.5,-1.5 l-1.5,-1.5 z" />
    <path android:fillColor="#FFFFFF" android:pathData="M100,45 l1,1 l1,-1 l-1,-1 z" />

</vector>